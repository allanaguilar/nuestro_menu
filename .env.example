DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=cambia-esta-clave-en-local
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nuestro_menu
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Nuestro Menú <no-reply@localhost>
# En producción, BREVO_API_KEY envía el correo por HTTPS. Render bloquea el SMTP.
BREVO_API_KEY=
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
WEB_CONCURRENCY=1
